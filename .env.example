# CareFlow AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# =============================================
# LLM Provider — Choose ONE: groq | gemini
# =============================================
LLM_PROVIDER=groq

# =============================================
# Option A: Groq (recommended — ultra-fast)
# Get your key at: https://console.groq.com
# =============================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Faster model for lower-stakes calls (optional)
GROQ_MODEL_FAST=llama-3.1-8b-instant

# =============================================
# Option B: Google Gemini
# Get your key at: https://aistudio.google.com/app/apikey
# =============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Alternative: gemini-1.5-pro for higher quality

# =============================================
# Flask
# =============================================
FLASK_SECRET_KEY=change-me-in-production-use-long-random-string
FLASK_ENV=development
FLASK_DEBUG=true

# =============================================
# Database (SQLite for hackathon demo)
# =============================================
DATABASE_URL=sqlite:///careflow.db

# =============================================
# Agent Settings
# =============================================
MAX_AGENT_RETRIES=3
AGENT_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.1

# =============================================
# Evaluation
# =============================================
EVAL_CASES_DIR=evaluation/cases
EVAL_GOLD_DIR=evaluation/gold
EVAL_RESULTS_DIR=evaluation/results

# =============================================
# Output Directories
# =============================================
REPORTS_DIR=reports
TRAJECTORIES_DIR=trajectories
